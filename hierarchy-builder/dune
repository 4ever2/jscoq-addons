(rule
 (targets coq-pkgs)
 (deps
  (package coq-hierarchy-builder))
 (action
  (run npx %{env:pkgtool=jscoq} build workdir/HB --top HB
                        --load ../elpi/coq-pkgs/elpi.coq-pkg
                        --package coq-pkgs/hierarchy-builder.coq-pkg)))

(alias
 (name all)
 (deps package.json))

(dirs workdir)
