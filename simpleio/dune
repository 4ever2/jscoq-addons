
(rule
 (targets coq-pkgs)
 (deps
  (package coq-simple-io)
  workdir/plugin/coqsimpleio_plugin.cma
  (:pkg-json coq-simpleio.json))
 (action
  (run npx %{env:pkgtool=jscoq} build %{pkg-json}
                   --load ../extlib/coq-pkgs/extlib.coq-pkg)))

(alias
 (name all)
 (deps package.json))

(dirs workdir)
